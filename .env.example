# ECE RoadMap - Production Environment Configuration Template
# Copy this file to .env or configure these in Cloudflare Pages / Deployment Settings

# Firebase Web Client Configuration (Safe for client-side injection)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Fixed Production Domain / Canonical Web URL (Used for QR Code generation)
VITE_PUBLIC_APP_URL=

# Backend / Server-side Secrets (Managed in Secret Manager / Settings)
GEMINI_API_KEY=
APP_URL=

