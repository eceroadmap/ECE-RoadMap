rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() && request.auth.token.email == "marwa.mgd.shmdeen@gmail.com";
    }

    function isAuthorizedModerator() {
      return isAuthenticated() && 
        resource != null && 
        resource.data.keys().hasAll(['activeEmails']) && 
        request.auth.token.email in resource.data.activeEmails;
    }

    function isAdmin() {
      return isOwner() || isAuthorizedModerator();
    }

    // 1. Private Student Journey & Progress Documents
    match /students/{userId} {
      allow read: if true;
      allow create: if request.auth.uid == userId || isAdmin();
      allow update: if request.auth.uid == userId || isAdmin();
      allow delete: if request.auth.uid == userId || isAdmin();
    }

    // 2. Dedicated Administrator Authorization Collection
    match /admins/{adminId} {
      allow read: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    // 3. Managed Public Curriculum Courses
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Managed Public Simulation & Engineering Software
    match /software/{softwareId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Managed Academic Resources
    match /academicResources/{resourceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Frequently Asked Questions (FAQ)
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6b. Graduation Projects
    match /graduation_projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Community Tips & Moderation
    match /communityTips/{tipId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isAdmin() || resource.data.authorId == request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // 8. Administrator Activity Audit Log
    match /adminLogs/{logId} {
      allow read: if isOwner();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // 9. System Configuration & Exhibition Settings (including moderators_list)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isOwner() || (configId == 'moderators_list' && isAdmin());
    }

    // 10. Public Site & Visitor Statistics Counter
    match /site_stats/{statId} {
      allow read: if true;
      allow create, update: if true;
    }

    // 11. Guest Student Visitors Registration
    match /guest_visitors/{guestId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // 12. Course to Skill Pipelines
    match /course_skill_pipelines/{pipelineId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 13. Authorized Supervisors / Moderators (إدارة المشرفين)
    match /moderators/{modId} {
      allow read: if isAuthenticated();
      allow write: if isOwner() || isAdmin();
    }

    // 14. Student Authentication Index
    match /student_auth_index/{username} {
      allow read, write: if isAuthenticated();
    }
  }
}
