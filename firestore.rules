rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)marwa\\.mgd\\.shmdeen@gmail\\.com'))
        || (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) 
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isOwner == true)
        || (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) 
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isAuthorizedModerator() {
      return isAuthenticated() && (
        // 1. Direct active record in admins collection
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) 
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'moderator'
          && (
            !('status' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data)
            || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'active'
          ))
        // 2. Direct active record in moderators collection by email or UID
        || (
          request.auth.token.email != null &&
          exists(/databases/$(database)/documents/moderators/$(request.auth.token.email))
        )
        || exists(/databases/$(database)/documents/moderators/$(request.auth.uid))
        // 3. In system_config/moderators_list activeEmails
        || (
          exists(/databases/$(database)/documents/system_config/moderators_list) &&
          request.auth.token.email != null &&
          request.auth.token.email in get(/databases/$(database)/documents/system_config/moderators_list).data.activeEmails
        )
      );
    }

    function isAdmin() {
      return isOwner() || isAuthorizedModerator();
    }

    // 1. Private Student Journey & Progress Documents
    match /students/{userId} {
      allow read: if true;
      allow create: if request.auth.uid == userId || isAdmin();
      allow update: if request.auth.uid == userId || isAdmin();
      allow delete: if request.auth.uid == userId || isAdmin();
    }

    // 2. Dedicated Administrator Authorization Collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 3. Managed Public Curriculum Courses
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Managed Public Simulation & Engineering Software
    match /software/{softwareId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Managed Academic Resources
    match /academicResources/{resourceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Frequently Asked Questions (FAQ)
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6b. Graduation Projects
    match /graduation_projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Community Tips & Moderation
    match /communityTips/{tipId} {
      allow read, write: if true;
    }

    // 8. Administrator Activity Audit Log
    match /adminLogs/{logId} {
      allow read: if isOwner();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // 9. System Configuration & Settings (system_config/moderators_list)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAuthenticated() || isOwner() || isAdmin();
    }

    // 10. Public Site & Visitor Statistics Counter
    match /site_stats/{statId} {
      allow read: if true;
      allow create, update: if true;
    }

    // 11. Guest Student Visitors Registration & Moderator Activation Signals
    match /guest_visitors/{guestId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 12. Course to Skill Pipelines
    match /course_skill_pipelines/{pipelineId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 13. Authorized Supervisors / Moderators (إدارة المشرفين)
    match /moderators/{modId} {
      allow read: if true;
      allow write: if isAuthenticated() || isOwner() || isAdmin();
    }

    // 14. Student Authentication Index
    match /student_auth_index/{username} {
      allow read, write: if isAuthenticated();
    }
  }
}
